{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "plainmark 主窗口的权限集合",
  "windows": ["main", "main-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "os:default"
  ]
}
